<h1>Our Services</h1>
<p class="lead text-end fw-bold">Transparent pricing for every repair.</p> 

<section class="services-info">
  <% if @service_catalogs_list.any? %>
    <div class="table-responsive rounded-4 overflow-hidden border border-2 border-secondary shadow-sm">
      <table class="table table-hover m-0">
        <thead>
          <tr class="table-bone-white border-bottom border-2 border-secondary">
            <th scope="col" class="text-start fw-bold border-end border-secondary">Service</th>
            <th scope="col" class="text-end fw-bold text-dark">Price</th>
          </tr>
        </thead>
        <tbody>
          <% @service_catalogs_list.each do |service| %>
            <tr class="table-dark-yellow">
              <td class="text-start py-2 fw-bold pt-2 border-end border-secondary">
                <%= link_to service.name, service_catalog_path(service) %>
              </td>
              <td class="text-end py-2 fw-bold pt-2 border-start border-secondary"><%= number_to_currency(service.current_price) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>There are no available services</p>
  <% end %>
</section>