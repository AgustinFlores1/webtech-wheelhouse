<% content_for(:title, @service_catalog.name) %>

<section class="customer-info mb-4 border p-3 rounded-5 border-primary border-3 text-start">
    <h1 class="mb-3 border-bottom border-primary pb-3"><%= @service_catalog.name %></h1>
    <p class="fs-5 m-2 "><strong>Price:</strong> <%= number_to_currency(@service_catalog.current_price) %></p>
    <p class="fs-5 m-2 "><strong>Active:</strong> <%= @service_catalog.is_active ? "Active" : "Inactive" %>
</section>

<div class="d-flex justify-content-between align-items-center mb-4">
  <%= link_to "Edit", edit_service_catalog_path(@service_catalog), class: "btn btn-outline-secondary" %>
  
  <%= button_to "Delete", service_catalog_path(@service_catalog),
      method: :delete,
      class: "btn btn-outline-danger",
      form: { data: { turbo_confirm: "Are you sure you want to delete the service \"#{@service_catalog.name}\"?" } } %>
</div>

<%= link_to "Back to Services", service_catalogs_path %>