<% content_for :title, "Sign in" %>

<section class="row justify-content-center" aria-labelledby="sign-in-heading">
  <div class="col-md-6 col-lg-4">
    <article class="card">
      <header class="card-header">
        <h1 id="sign-in-heading" class="h4 mb-0">Sign in</h1>
      </header>

      <%= form_with url: session_path, class: "card-body" do |form| %>
        <div class="mb-3">
          <%= form.label :email_address, "Email address", class: "form-label" %>
          <%= form.email_field :email_address, class: "form-control",
                required: true, autofocus: true, autocomplete: "username",
                value: params[:email_address] %>
        </div>

        <div class="mb-3">
          <%= form.label :password, class: "form-label" %>
          <%= form.password_field :password, class: "form-control",
                required: true, autocomplete: "current-password", maxlength: 72 %>
        </div>

        <%= form.submit "Sign in", class: "btn btn-primary w-100" %>
      <% end %>

      <footer class="card-footer text-center">
        <%= link_to "Forgot your password?", new_password_path %>
      </footer>
    </article>
  </div>
</section>