<% content_for :title, "Create an account" %>

<section class="row justify-content-center" aria-labelledby="sign-up-heading">
  <div class="col-md-6 col-lg-4">
    <article class="card">
      <header class="card-header">
        <h1 id="sign-up-heading" class="h4 mb-0">Create an account</h1>
      </header>

      <%= form_with model: @user, url: registration_path, class: "card-body" do |form| %>
        <%= render "shared/error_summary", record: @user %>

        <div class="mb-3">
          <%= form.label :email_address, "Email address", class: "form-label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                class: ["form-control", { "is-invalid": @user.errors.include?(:email_address) }] %>
          <% @user.errors.full_messages_for(:email_address).each do |message| %>
            <div class="invalid-feedback"><%= message %></div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= form.label :password, class: "form-label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                aria: { describedby: "password-hint" },
                class: ["form-control", { "is-invalid": @user.errors.include?(:password) }] %>
          <div id="password-hint" class="form-text">
            At least <%= User::PASSWORD_MINIMUM_LENGTH %> characters.
          </div>
          <% @user.errors.full_messages_for(:password).each do |message| %>
            <div class="invalid-feedback"><%= message %></div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= form.label :password_confirmation, "Repeat the password", class: "form-label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                class: ["form-control", { "is-invalid": @user.errors.include?(:password_confirmation) }] %>
          <% @user.errors.full_messages_for(:password_confirmation).each do |message| %>
            <div class="invalid-feedback"><%= message %></div>
          <% end %>
        </div>

        <%= form.submit "Create account", class: "btn btn-primary w-100" %>
      <% end %>

      <footer class="card-footer text-center">
        Already have an account? <%= link_to "Sign in", new_session_path %>
      </footer>
    </article>
  </div>
</section>