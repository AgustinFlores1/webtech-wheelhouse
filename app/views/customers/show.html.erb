<% content_for(:title, @customer.name) %>

<p class="lead text-end fw-bold">Customer since <%= @customer.created_at.strftime("%B %Y") %></p>

<section class="customer-info mb-4 border p-3 rounded-5 border-primary border-3 text-start">
  <h1 class="mb-3 border-bottom border-primary pb-3"><%= @customer.name %></h1>
  <p class="fs-5 m-0"><strong class="text-primary">Phone:</strong> <%= @customer.phone %></p>
</section>

<h2 class="mb-3 border-bottom border-primary pb-3 fw-bold text-white">Bikes Owned</h2>

<% if @customer.bikes.any? %>
  <div class="table-responsive rounded-4 overflow-hidden border border-2 border-secondary shadow-sm mb-3">
    <table class="table table-hover m-0">
      <thead>
        <tr class="table-header-yellow border-bottom border-2 border-secondary">
          <th scope="col" class="text-start fw-bold border-end border-secondary">Serial Number</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary d-none d-md-table-cell">Make Model</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary d-none d-md-table-cell">Colour</th>
          <th scope="col" class="text-end fw-bold">Owner</th>
        </tr>
      </thead>
      <tbody>
        <% @customer.bikes.list_by_serial.each do |bike| %>
          <%= render "bikes/bike", bike: bike %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>This customer doesn't own any bikes</p>
<% end %>

<%= link_to "Back to Customers", customers_path, class: "btn btn-primary" %>