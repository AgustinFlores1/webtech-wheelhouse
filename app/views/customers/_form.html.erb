<%= form_with model: customer do |f| %>
  <%= render "shared/error_summary", record: customer %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name,
          class: ["form-control", { "is-invalid": customer.errors.include?(:name) }] %>
    <% customer.errors.full_messages_for(:name).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>
  <div class="mb-3">
    <%= f.label :phone, class: "form-label" %>
    <%= f.text_field :phone,
          class: ["form-control", { "is-invalid": customer.errors.include?(:phone) }] %>
    <% customer.errors.full_messages_for(:phone).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", customers_path, class: "btn btn-outline-secondary" %>
<% end %>