<h1 style="font-size: 20px; margin: 0 0 16px;">Welcome to Wheelhouse</h1>

<p>
  Your Wheelhouse account <strong><%= @user.email_address %></strong> is ready.
</p>

<p>
  <%= link_to "Sign in to Wheelhouse", new_session_url,
