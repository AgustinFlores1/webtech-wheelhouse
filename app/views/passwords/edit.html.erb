<% content_for :title, "Choose a new password" %>

<section class="row justify-content-center" aria-labelledby="new-password-heading">
  <div class="col-md-6 col-lg-4">
    <article class="card">
      <header class="card-header">
        <h1 id="new-password-heading" class="h4 mb-0">Choose a new password</h1>
      </header>

      <%= form_with url: password_path(params[:token]), method: :put, class: "card-body" do |form| %>
        <div class="mb-3">
          <%= form.label :password, "New password", class: "form-label" %>
          <%= form.password_field :password, class: "form-control",
                required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
        </div>

        <div class="mb-3">
          <%= form.label :password_confirmation, "Repeat the new password", class: "form-label" %>
          <%= form.password_field :password_confirmation, class: "form-control",
                required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>

        <%= form.submit "Save new password", class: "btn btn-primary w-100" %>
      <% end %>
    </article>
  </div>
</section>