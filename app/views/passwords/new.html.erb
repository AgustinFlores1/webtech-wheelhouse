<% content_for :title, "Forgot your password?" %>

<section class="row justify-content-center" aria-labelledby="forgot-heading">
  <div class="col-md-6 col-lg-4">
    <article class="card">
      <header class="card-header">
        <h1 id="forgot-heading" class="h4 mb-0">Forgot your password?</h1>
      </header>

      <%= form_with url: passwords_path, class: "card-body" do |form| %>
        <p class="text-body-secondary">
          Write the email address of your account and Wheelhouse will send you a link to choose a new password.
        </p>

        <div class="mb-3">
          <%= form.label :email_address, "Email address", class: "form-label" %>
          <%= form.email_field :email_address, class: "form-control",
                required: true, autofocus: true, autocomplete: "username",
                value: params[:email_address] %>
        </div>

        <%= form.submit "Email me a reset link", class: "btn btn-primary w-100" %>
      <% end %>

      <footer class="card-footer text-center">
        <%= link_to "Back to sign in", new_session_path %>
      </footer>
    </article>
  </div>
</section>
