<h1>Repairs</h1>

<% if @repairs_list.any? %>
  <div class="table-responsive rounded-4 overflow-hidden border border-2 border-secondary shadow-sm">
    <table class="table table-hover m-0">
      <thead>
        <tr class="table-header-yellow border-bottom border-2 border-secondary">
          <th scope="col" class="text-start fw-bold border-end border-secondary">Bike</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary">Customer</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary d-none d-md-table-cell">Mechanic</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary d-none d-md-table-cell">Returned</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary d-none d-md-table-cell">Status</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary">Promised Date</th>
          <th scope="col" class="text-end fw-bold"></th>
        </tr>
      </thead>
      <tbody>
        <% @repairs_list.each do |repair| %>
          <%= render "repairs/repair", repair: repair %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>There are no repairs in the system</p>
<% end %>