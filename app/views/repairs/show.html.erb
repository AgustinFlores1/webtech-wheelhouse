<% content_for(:title, "Repair N°#{@repair.id}") %>

<section class="customer-info mb-4 border p-3 rounded-5 border-primary border-3 text-start">
    <h1 class="mb-3 border-bottom border-primary pb-3">Repair #<%= @repair.id %></h1>

    <p class="fs-5 m-2 "><strong>Status:</strong> <%= @repair.status %></p>
    <p class="fs-5 m-2 "><strong>Reported Issue:</strong> <%= @repair.reported_issue %></p>
    <div class="fs-5 m-2">
      <strong>Diagnosis:</strong>
      <% if @repair.diagnosis.present? %>
        <%= @repair.diagnosis %>
      <% else %>
        Not diagnosed yet
      <% end %>
    </div>
    <p class="fs-5 m-2 "><strong>Promised Return:</strong> <%= @repair.promised_return_on%></p>
    <p class="fs-5 m-2 "><strong>Return date:</strong>
      <%= @repair.closed_at.nil? ? "Not yet returned" : @repair.closed_at.strftime("%B %d, %Y at %I:%M %p") %>
    </p>

    <p class="fs-5 m-2 "><strong>Bike:</strong>
      <%= link_to @repair.bike.serial_number, bike_path(@repair.bike) %>
    </p>
    <p class="fs-5 m-2 "><strong>Brought in by:</strong>
      <%= link_to @repair.customer.name, customer_path(@repair.customer) %>
    </p>
    <p class="fs-5 m-2 "><strong>Taken in by:</strong>
      <%= @repair.taken_in_by&.display_name || "Not recorded" %>
    </p>
   <p class="fs-5 m-2 "><strong>Mechanic:</strong>
      <% if @repair.assigned_mechanic.present? %>
        <%= link_to @repair.assigned_mechanic.name, staff_member_path(@repair.assigned_mechanic) %>
      <% else %>
        Unassigned
      <% end %>
    </p>
</section>

<div class="d-flex justify-content-between align-items-center mb-4">
  <%= link_to "Edit", edit_repair_path(@repair), class: "btn btn-outline-secondary" %>
  <%= button_to "Delete", repair_path(@repair), method: :delete,
        class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "Are you sure you want to delete the repair \"#{@repair.id}\"?" } } %>
</div>

<h2 class="mb-3 border-bottom border-primary pb-3 fw-bold text-white">Intake Photos</h2>
<% if @repair.intake_photos.attached? %>
  <div class="row g-2">
    <% @repair.intake_photos.each_with_index do |photo, index| %>
      <div class="col-6 col-md-4 col-lg-3">
        <%= link_to rails_blob_path(photo, disposition: "inline"), target: "_blank", rel: "noopener" do %>
          <%= image_tag photo.variant(:large),
                alt: "Intake photo #{index + 1} of repair ##{@repair.id}, bike #{@repair.bike.serial_number} (#{@repair.bike.make_model})",
                class: "img-fluid rounded border" %>
        <% end %>
        <%= button_to "Remove", repair_intake_photo_path(@repair, photo), method: :delete,
              class: "btn btn-sm btn-outline-danger mt-1 w-100",
              form: { data: { turbo_confirm: "Remove photo #{photo.filename} from repair ##{@repair.id}?" } } %>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No intake photos were taken for this repair</p>
<% end %>

<h2 class="mb-2 mt-4 border-top border-primary pb-3 pt-3 fw-bold text-white">Services Charged</h2>

<% if @repair.repair_services.any? %>
  <div class="table-responsive rounded-4 overflow-hidden border border-2 border-secondary shadow-sm mb-3">
    <table class="table table-hover m-0">
      <thead>
        <tr class="table-header-yellow border-bottom border-2 border-secondary">
          <th scope="col" class="text-start fw-bold border-end border-secondary">Service</th>
          <th scope="col" class="text-end fw-bold">Price Charged</th>
        </tr>
      </thead>
      <tbody>
        <% @repair.repair_services.list_by_service_name.each do |line| %>
          <tr class="table-row-dark">
            <td class="text-start py-2 fw-bold pt-2 border-end border-secondary"><%= line.service_catalog.name %></td>
            <td class="text-end py-2 fw-bold pt-2 border-start border-secondary"><%= number_to_currency(line.agreed_price) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="fs-5"><strong class="text-primary">Total:</strong> <%= number_to_currency(@repair.total) %></p>
<% else %>
  <p>No services appear on this repair</p>
<% end %>

<%= link_to "Back to Repairs", repairs_path, class: "btn btn-primary" %>