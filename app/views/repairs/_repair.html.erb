<tr class="<%= repair.promised_return_on < Date.current && repair.closed_at.nil? ? "table-overdue" : "table-row-dark" %>">
  <td class="text-start py-2 fw-bold pt-2 border-end border-secondary"><%= link_to repair.bike.serial_number, bike_path(repair.bike) %></td>
  <td class="text-start py-2 fw-bold pt-2 border-end border-secondary"><%= link_to repair.customer.name, customer_path(repair.customer) %></td>
  <td class="text-start py-2 fw-bold pt-2 border-end border-secondary"><%= repair.assigned_mechanic.nil? ? "Unassigned" : repair.assigned_mechanic.name %></td>
  <td class="text-start py-2 fw-bold pt-2 border-end border-secondary"><%= repair.closed_at.nil? ? "Not yet returned" : repair.closed_at.strftime("%B %d, %Y at %I:%M %p") %></td>
  <td class="text-start py-2 fw-bold pt-2 border-end border-secondary"><%= repair.status %></td>
  <td class="text-start py-2 fw-bold pt-2 border-end border-secondary"><%= repair.promised_return_on %></td>
  <td class="text-end py-2 fw-bold pt-2 border-start border-secondary"><%= link_to "Detailed View", repair_path(repair) %></td>
</tr>