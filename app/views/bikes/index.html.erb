<h1>Bikes</h1>

<% if @bikes_list.any? %>
  <div class="table-responsive rounded-4 overflow-hidden border border-2 border-secondary shadow-sm">
    <table class="table table-hover m-0">
      <thead>
        <tr class="table-header-yellow border-bottom border-2 border-secondary">
          <th scope="col" class="text-start fw-bold border-end border-secondary">Serial Number</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary">Make Model</th>
          <th scope="col" class="text-start fw-bold border-end border-secondary">Colour</th>
          <th scope="col" class="text-end fw-bold">Owner</th>
        </tr>
      </thead>
      <tbody>
        <% @bikes_list.each do |bike| %>
          <%= render "bike", bike: bike %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No bikes in the system.</p>
<% end %>