<%= form_with model: staff_member do |f| %>
  <%= render "shared/error_summary", record: staff_member %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name,
          class: ["form-control", { "is-invalid": staff_member.errors.include?(:name) }] %>
    <% staff_member.errors.full_messages_for(:name).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>
  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role,
          class: ["form-control", { "is-invalid": staff_member.errors.include?(:role) }] %>
    <% staff_member.errors.full_messages_for(:role).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", staff_members_path, class: "btn btn-outline-secondary" %>
<% end %>